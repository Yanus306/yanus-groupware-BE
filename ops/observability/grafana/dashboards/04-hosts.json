        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "100 * (1 - avg by(instance)(rate(node_cpu_seconds_total{environment=\"$environment\",instance=~\"$instance\",mode=\"idle\"}[$__rate_interval])))",
          "legendFormat": "{{instance}}",
          "range": false,
          "editorMode": "code",
          "instant": true
