  "panels": [
    {
      "id": 1,
      "type": "text",
      "title": "API 요청·오류 분석",
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 24,
        "h": 3
      },
      "options": {
        "mode": "markdown",
        "content": "HTTP histogram으로 지연을 계산합니다. 업무 요청에서 Actuator·Swagger 조회는 제외합니다. `UNKNOWN` URI는 Spring이 경로를 확정하기 전 거부한 요청일 수 있습니다. 하단에서 JVM → Tomcat → Hikari 병목을 확인합니다."
      }
    },
    {
      "id": 2,
      "title": "RPS",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "yanus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "sum(rate(http_server_requests_seconds_count{environment=\"$environment\",instance=~\"$instance\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[$__rate_interval]))",
          "legendFormat": "{{instance}}",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "수집 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
    {
      "id": 3,
      "title": "4xx 비율",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "yanus-prometheus"
      },
      "gridPos": {
        "x": 4,
        "y": 3,
        "w": 4,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "(sum(rate(http_server_requests_seconds_count{environment=\"$environment\",instance=~\"$instance\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\",status=~\"4..\"}[$__rate_interval])) or (0 * sum(rate(http_server_requests_seconds_count{environment=\"$environment\",instance=~\"$instance\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[$__rate_interval])))) / clamp_min(sum(rate(http_server_requests_seconds_count{environment=\"$environment\",instance=~\"$instance\",uri!~\"/actuator.*|/v3/api-docs.*|/swagger-ui.*\"}[$__rate_interval])),0.000001) * 100",
          "legendFormat": "{{instance}}",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "percent",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "수집 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "green",
                "value": null
              },
              {
                "color": "orange",
                "value": 1
              },
              {
                "color": "red",
                "value": 5
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "axisPlacement": "auto"
          }
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "textMode": "value",
        "colorMode": "value",
        "graphMode": "none",
        "justifyMode": "auto",
        "orientation": "auto"
      }
    },
