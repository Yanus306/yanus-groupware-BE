      },
      "options": {
        "mode": "markdown",
        "content": "현재 DB는 자체 운영 PostgreSQL입니다. DB 서버 자원과 PostgreSQL 내부 통계를 함께 확인합니다. Hikari 연결 풀 지표는 02 API 요청·오류에서 확인하세요."
      }
    },
    {
      "id": 2,
      "title": "DB 연결",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "yanus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 3,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "pg_up{environment=\"$environment\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "editorMode": "code",
          "instant": true
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "decimals": 2,
          "color": {
            "mode": "thresholds"
          },
          "noValue": "수집 없음",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "color": "red",
                "value": null
              },
              {
                "color": "green",
                "value": 1
              }
            ]
          },
          "custom": {
            "drawStyle": "line",
            "lineWidth": 2,
            "fillOpacity": 10,
            "spanNulls": false,
            "axisPlacement": "auto"
          },
          "mappings": [
            {
              "type": "value",
              "options": {
                "0": {
                  "text": "DOWN",
                  "color": "red"
                },
                "1": {
                  "text": "UP",
                  "color": "green"
                }
              }
            }
          ]
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
