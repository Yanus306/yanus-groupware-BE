    {
      "id": 2,
      "title": "파일 존재",
      "description": "연결·수집 성공 여부입니다. DOWN이면 서비스 상태, exporter와 네트워크를 구분해 확인하세요. UP은 업무 기능 전체의 정상 보장이 아닙니다.",
      "type": "stat",
      "datasource": {
        "type": "prometheus",
        "uid": "yanus-prometheus"
      },
      "gridPos": {
        "x": 0,
        "y": 5,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "expr": "yanus_log_file_exists{environment=\"$environment\",instance=\"app-server\"}",
          "legendFormat": "{{instance}}",
          "range": false,
          "editorMode": "code",
