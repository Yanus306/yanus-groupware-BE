local.file_match "backend" {
  path_targets = [{
    __path__ = "/var/log/yanus/prod/application.log",
    environment = "prod",
    service = "backend",
    instance = "app-server",
  }]
}

loki.source.file "backend" {
  targets = local.file_match.backend.targets
  forward_to = [loki.process.backend.receiver]
}

loki.process "backend" {
  stage.json {
    expressions = { level = "level", timestamp = "timestamp" }
    drop_malformed = true
  }
  stage.timestamp {
    source = "timestamp"
    format = "RFC3339Nano"
  }
  stage.labels {
    values = { level = "" }
  }
  forward_to = [loki.write.monitoring.receiver]
}

loki.write "monitoring" {
  endpoint {
    url = "http://MONITORING_ADDRESS:3101/loki/api/v1/push"
    batch_wait = "1s"
    basic_auth {
      username = "alloy"
      password_file = "/etc/alloy/loki-password"
    }
  }
}
