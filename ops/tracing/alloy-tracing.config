otelcol.receiver.otlp "yanus_traces" {
  http {
    endpoint = "127.0.0.1:4318"
  }
  output {
    traces = [otelcol.processor.memory_limiter.yanus_traces.input]
  }
}

otelcol.processor.memory_limiter "yanus_traces" {
  check_interval = "1s"
  limit = "128MiB"
  spike_limit = "32MiB"
  output {
    traces = [otelcol.processor.transform.yanus_privacy.input]
  }
}

otelcol.processor.transform "yanus_privacy" {
  error_mode = "propagate"
  trace_statements {
    context = "resource"
    statements = [
      `keep_keys(attributes, ["service.name", "service.version", "service.instance.id", "deployment.environment.name"])`,
    ]
  }
  trace_statements {
    context = "span"
    statements = [
      `keep_keys(attributes, ["http.request.method", "http.response.status_code", "http.route", "db.system.name", "db.system", "db.operation.name", "db.operation", "error.type"])`,
      `set(status.message, "")`,
      `set(name, "operation")`,
      `set(name, attributes["http.request.method"]) where attributes["http.request.method"] != nil`,
      `set(name, Concat([attributes["http.request.method"], attributes["http.route"]], " ")) where attributes["http.request.method"] != nil and attributes["http.route"] != nil`,
      `set(name, "DB call") where attributes["db.system.name"] != nil or attributes["db.system"] != nil`,
      `set(name, Concat(["DB", attributes["db.operation.name"]], " ")) where attributes["db.operation.name"] != nil`,
    ]
  }
  trace_statements {
    context = "spanevent"
    statements = [
      `keep_keys(attributes, ["exception.type"])`,
      `set(name, "event")`,
    ]
  }
  output {
    traces = [otelcol.processor.batch.yanus_traces.input]
  }
}

otelcol.processor.batch "yanus_traces" {
  timeout = "1s"
  send_batch_size = 128
  send_batch_max_size = 256
  output {
    traces = [otelcol.exporter.otlphttp.yanus_tempo.input]
  }
}

local.file "tempo_authorization" {
  filename = "/etc/alloy/tempo-authorization"
  is_secret = true
}

otelcol.auth.headers "yanus_tempo" {
  header {
    key = "Authorization"
    value = local.file.tempo_authorization.content
  }
}

otelcol.exporter.otlphttp "yanus_tempo" {
  client {
    endpoint = "http://MONITORING_ADDRESS:4320"
    auth = otelcol.auth.headers.yanus_tempo.handler
    timeout = "3s"
  }
  sending_queue {
    queue_size = 256
    num_consumers = 2
  }
  retry_on_failure {
    initial_interval = "1s"
    max_interval = "5s"
    max_elapsed_time = "30s"
  }
}
